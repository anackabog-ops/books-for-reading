{
  "provider": "Azure Speech",
  "sourceSha256": "925b4793baa3b72533268dd844be40b7968d9222eb28cdba218cedcdbc84fa1c",
  "timingVersion": 2,
  "voiceSwitchGapSeconds": 0.0625,
  "sampleRate": 24000,
  "duration": 442.512,
  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Moteris pastatė skėtį prie durų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 0,
      "end": 3.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Nuo jo ant grindų lašėjo vanduo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 3.1125,
      "end": 6.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "Tomas atnešė rankšluostį iš vonios.",
      "voice": "lt-LT-LeonasNeural",
      "start": 6.1125,
      "end": 9.3875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "— Ačiū. Aš Ieva, — pasakė ji.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Ačiū. Aš Ieva, ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— pasakė ji.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 9.3875,
      "end": 15.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "— Gal atėjau ne laiku?",
      "voice": "lt-LT-OnaNeural",
      "start": 15.45,
      "end": 18.0375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-001-i-001.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "— Aš Tomas. Pats nebežinau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 18.0375,
      "end": 22.0875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Prašau, sėskitės. Tik ne ant dėžės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 22.0875,
      "end": 26.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-002-i-001.mp3"
    },
    {
      "mark": "p-002-i-002",
      "block": 2,
      "item": 2,
      "text": "Ji atrodo stipresnė, negu yra.",
      "voice": "lt-LT-LeonasNeural",
      "start": 26.7875,
      "end": 29.8625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-002-i-002.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "Jis nuėmė striukę nuo vienintelės laisvos kėdės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 29.8625,
      "end": 33.625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-003-i-000.mp3"
    },
    {
      "mark": "p-003-i-001",
      "block": 3,
      "item": 1,
      "text": "Pats atsisėdo ant kitos, šalia stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 33.625,
      "end": 37.15,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-003-i-001.mp3"
    },
    {
      "mark": "p-003-i-002",
      "block": 3,
      "item": 2,
      "text": "Ant jos dar gulėjo jo marškiniai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 37.15,
      "end": 40.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-003-i-002.mp3"
    },
    {
      "mark": "p-003-i-003",
      "block": 3,
      "item": 3,
      "text": "Tomas tyliai juos ištraukė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 40.1125,
      "end": 42.95,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-003-i-003.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "— Gal pirmiausia valgom? — paklausė Ieva.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Gal pirmiausia valgom? ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— paklausė Ieva.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 42.95,
      "end": 47.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-004-i-000.mp3"
    },
    {
      "mark": "p-004-i-001",
      "block": 4,
      "item": 1,
      "text": "— Po darbo dar nieko nevalgiau.",
      "voice": "lt-LT-OnaNeural",
      "start": 47.6375,
      "end": 50.5625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-004-i-001.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "Tomas pastūmė jai antrą porciją.",
      "voice": "lt-LT-LeonasNeural",
      "start": 50.5625,
      "end": 53.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-005-i-000.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "— Čia vištiena. Be svogūnų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 53.6,
      "end": 57.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-006-i-000.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Puiku. Ar turite duonos?",
      "voice": "lt-LT-OnaNeural",
      "start": 57.825,
      "end": 62.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-007-i-000.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Duona bus rytoj. Aštuntą prasideda tvarka.",
      "voice": "lt-LT-LeonasNeural",
      "start": 62.1625,
      "end": 67.1875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-008-i-000.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "Ieva pažiūrėjo į dėžę su batais.",
      "voice": "lt-LT-LeonasNeural",
      "start": 67.1875,
      "end": 70.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-009-i-000.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "— Iki aštuntos dar turite laiko.",
      "voice": "lt-LT-OnaNeural",
      "start": 70.375,
      "end": 73.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-010-i-000.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "Jie pradėjo valgyti. Kurį laiką buvo tylu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 73.5375,
      "end": 78.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-011-i-000.mp3"
    },
    {
      "mark": "p-011-i-001",
      "block": 11,
      "item": 1,
      "text": "Tomas norėjo paaiškinti, kodėl jos nekvietė,",
      "voice": "lt-LT-LeonasNeural",
      "start": 78.4125,
      "end": 81.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-011-i-001.mp3"
    },
    {
      "mark": "p-011-i-002",
      "block": 11,
      "item": 2,
      "text": "bet nežinojo, nuo ko pradėti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 81.1,
      "end": 84.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-011-i-002.mp3"
    },
    {
      "mark": "p-011-i-003",
      "block": 11,
      "item": 3,
      "text": "Ieva padėjo šakutę šalia dėžutės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 84.0125,
      "end": 87.5875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-011-i-003.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "— Parodyti kvietimą? Ten jūsų vardas.",
      "voice": "lt-LT-OnaNeural",
      "start": 87.5875,
      "end": 92.2,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-012-i-000.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Taip, prašau. Galiu pažiūrėti?",
      "voice": "lt-LT-LeonasNeural",
      "start": 92.2,
      "end": 96.55,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "Ji atidarė žinutę ir parodė ekraną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 96.55,
      "end": 99.9625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "„Labas, Ieva. Lauksiu tavęs septintą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 99.9625,
      "end": 104.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-014-i-001.mp3"
    },
    {
      "mark": "p-014-i-002",
      "block": 14,
      "item": 2,
      "text": "Vakarienė pas mane. Adresas apačioje.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 104.7875,
      "end": 109.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-014-i-002.mp3"
    },
    {
      "mark": "p-014-i-003",
      "block": 14,
      "item": 3,
      "text": "Tomas perskaitė žinutę du kartus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 109.6375,
      "end": 112.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-014-i-003.mp3"
    },
    {
      "mark": "p-014-i-004",
      "block": 14,
      "item": 4,
      "text": "Jis net Austėjai taip retai rašydavo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 112.825,
      "end": 116.0625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-014-i-004.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "— Aš sutikau vakarieniauti su kaimynu,",
      "voice": "lt-LT-OnaNeural",
      "start": 116.0625,
      "end": 119.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "— pasakė Ieva. — Taip buvo parašyta.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— pasakė Ieva.",
          "voice": "lt-LT-LeonasNeural"
        },
        {
          "text": " — Taip buvo parašyta.",
          "voice": "lt-LT-OnaNeural"
        }
      ],
      "start": 119.4125,
      "end": 123.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-015-i-001.mp3"
    },
    {
      "mark": "p-015-i-002",
      "block": 15,
      "item": 2,
      "text": "Bet nepagalvojau, kad jis manęs nelaukia.",
      "voice": "lt-LT-OnaNeural",
      "start": 123.7875,
      "end": 127.4375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-015-i-002.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "— Aš ne prieš vakarienę, — pasakė Tomas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 127.4375,
      "end": 130.7625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "— Tik norėčiau žinoti apie savo kvietimus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 130.7625,
      "end": 133.9875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-016-i-001.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "Jis paėmė savo telefoną nuo stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 133.9875,
      "end": 137.175,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-017-i-000.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Parodyk vakarienės nustatymus, prašau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 137.175,
      "end": 140.525,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-018-i-000.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "Telefone atsirado sąrašas. Tomas skaitė garsiai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 140.525,
      "end": 145.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-019-i-000.mp3"
    },
    {
      "mark": "p-019-i-001",
      "block": 19,
      "item": 1,
      "text": "„Bendra vakarienė. Kiekvieną penktadienį. Du žmonės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 145.825,
      "end": 152.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-019-i-001.mp3"
    },
    {
      "mark": "p-019-i-002",
      "block": 19,
      "item": 2,
      "text": "Siųsti kvietimą. Užsakyti dvi porcijas.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 152.5375,
      "end": 157.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-019-i-002.mp3"
    },
    {
      "mark": "p-019-i-003",
      "block": 19,
      "item": 3,
      "text": "Prie visų eilučių buvo žodis „Taip“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 157.375,
      "end": 160.775,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-019-i-003.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "— Kada aš sutikau? — paklausė jis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 160.775,
      "end": 164.9125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Šiandien. Kai prijungėte telefoną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 164.9125,
      "end": 169.275,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-021-i-000.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Tomas prisiminė mažas raides ekrane.",
      "voice": "lt-LT-LeonasNeural",
      "start": 169.275,
      "end": 172.6625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Ten buvo ne tik trys klausimai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 172.6625,
      "end": 175.5875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-022-i-001.mp3"
    },
    {
      "mark": "p-022-i-002",
      "block": 22,
      "item": 2,
      "text": "Po jais buvo dar vienas sąrašas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 175.5875,
      "end": 178.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-022-i-002.mp3"
    },
    {
      "mark": "p-022-i-003",
      "block": 22,
      "item": 3,
      "text": "Jis jo neskaitė. Tik paspaudė „Taip“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 178.4625,
      "end": 183.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-022-i-003.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "— O kodėl Ieva? — paklausė Tomas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 183.225,
      "end": 187.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-023-i-000.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "— Ji gyvena netoliese ir sutiko dalyvauti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 187.4875,
      "end": 190.9625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-024-i-000.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Ieva palietė savo telefono ekraną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 190.9625,
      "end": 194.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-025-i-000.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "— Taip. Mano nustatymai tokie patys.",
      "voice": "lt-LT-OnaNeural",
      "start": 194.225,
      "end": 199.0375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-026-i-000.mp3"
    },
    {
      "mark": "p-026-i-001",
      "block": 26,
      "item": 1,
      "text": "Tik aš perskaičiau apie bendrą vakarienę.",
      "voice": "lt-LT-OnaNeural",
      "start": 199.0375,
      "end": 202.475,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-026-i-001.mp3"
    },
    {
      "mark": "p-026-i-002",
      "block": 26,
      "item": 2,
      "text": "Kartais norisi pavalgyti ne vienai.",
      "voice": "lt-LT-OnaNeural",
      "start": 202.475,
      "end": 205.725,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-026-i-002.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "— Ir dažnai taip vakarieniaujate?",
      "voice": "lt-LT-LeonasNeural",
      "start": 205.725,
      "end": 208.575,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-027-i-000.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "— Pirmą kartą. Kol kas įdomu.",
      "voice": "lt-LT-OnaNeural",
      "start": 208.575,
      "end": 212.6875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-028-i-000.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "Tomas vėl pažvelgė į savo sąrašą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 212.6875,
      "end": 215.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-029-i-000.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "— Užsakymas įprastas. Tik žmogus naujas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 215.875,
      "end": 220.7125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-030-i-000.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "Ieva nusijuokė ir vėl paėmė šakutę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 220.7125,
      "end": 224.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-031-i-000.mp3"
    },
    {
      "mark": "p-031-i-001",
      "block": 31,
      "item": 1,
      "text": "Tomas atidarė čekį. Šešiolika eurų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 224.225,
      "end": 229.2125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-031-i-001.mp3"
    },
    {
      "mark": "p-031-i-002",
      "block": 31,
      "item": 2,
      "text": "Kaina buvo už abi porcijas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 229.2125,
      "end": 232.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-031-i-002.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "— Galiu sumokėti už savo, — pasakė Ieva.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Galiu sumokėti už savo, ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— pasakė Ieva.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 232.1375,
      "end": 236.9,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-032-i-000.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "Jis jau norėjo atsakyti, kad nereikia.",
      "voice": "lt-LT-LeonasNeural",
      "start": 236.9,
      "end": 240.0625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-033-i-000.mp3"
    },
    {
      "mark": "p-033-i-001",
      "block": 33,
      "item": 1,
      "text": "Taip būtų paprasčiau. Bet rytoj reikės apsipirkti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 240.0625,
      "end": 245.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-033-i-001.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "— Gerai. Aštuonis eurus, prašau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 245.1375,
      "end": 249.575,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-034-i-000.mp3"
    },
    {
      "mark": "p-035-i-000",
      "block": 35,
      "item": 0,
      "text": "Ji sumokėjo telefonu. Tomas patikrino sumą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 249.575,
      "end": 254.575,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-035-i-000.mp3"
    },
    {
      "mark": "p-035-i-001",
      "block": 35,
      "item": 1,
      "text": "Tada padėjo telefoną ekranu žemyn.",
      "voice": "lt-LT-LeonasNeural",
      "start": 254.575,
      "end": 257.8125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-035-i-001.mp3"
    },
    {
      "mark": "p-035-i-002",
      "block": 35,
      "item": 2,
      "text": "Pirmą kartą šį vakarą neskubėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 257.8125,
      "end": 260.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-035-i-002.mp3"
    },
    {
      "mark": "p-036-i-000",
      "block": 36,
      "item": 0,
      "text": "— Gal vandens? — paklausė jis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 260.7875,
      "end": 265.05,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-036-i-000.mp3"
    },
    {
      "mark": "p-037-i-000",
      "block": 37,
      "item": 0,
      "text": "— Taip, prašau. Tik truputį.",
      "voice": "lt-LT-OnaNeural",
      "start": 265.05,
      "end": 269.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-037-i-000.mp3"
    },
    {
      "mark": "p-038-i-000",
      "block": 38,
      "item": 0,
      "text": "Švarią stiklinę jis rado iš karto.",
      "voice": "lt-LT-LeonasNeural",
      "start": 269.3125,
      "end": 272.5,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-038-i-000.mp3"
    },
    {
      "mark": "p-038-i-001",
      "block": 38,
      "item": 1,
      "text": "Antros teko ieškoti dėžėje su rankšluosčiais.",
      "voice": "lt-LT-LeonasNeural",
      "start": 272.5,
      "end": 276.2,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-038-i-001.mp3"
    },
    {
      "mark": "p-038-i-002",
      "block": 38,
      "item": 2,
      "text": "Ieva nieko nesakė, tik prilaikė dėžę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 276.2,
      "end": 279.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-038-i-002.mp3"
    },
    {
      "mark": "p-039-i-000",
      "block": 39,
      "item": 0,
      "text": "Jie kalbėjo apie parduotuvę gatvės gale.",
      "voice": "lt-LT-LeonasNeural",
      "start": 279.8,
      "end": 283.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-000.mp3"
    },
    {
      "mark": "p-039-i-001",
      "block": 39,
      "item": 1,
      "text": "Ieva ten pirko duoną beveik kasdien.",
      "voice": "lt-LT-LeonasNeural",
      "start": 283.1375,
      "end": 286.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-001.mp3"
    },
    {
      "mark": "p-039-i-002",
      "block": 39,
      "item": 2,
      "text": "Jos tėtis gyveno kitame name, netoliese.",
      "voice": "lt-LT-LeonasNeural",
      "start": 286.4125,
      "end": 290.2375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-002.mp3"
    },
    {
      "mark": "p-039-i-003",
      "block": 39,
      "item": 3,
      "text": "Ji dažnai užsukdavo pas jį po darbo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 290.2375,
      "end": 293.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-003.mp3"
    },
    {
      "mark": "p-039-i-004",
      "block": 39,
      "item": 4,
      "text": "Tomas papasakojo apie kaimyną ir raktą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 293.4875,
      "end": 296.775,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-004.mp3"
    },
    {
      "mark": "p-039-i-005",
      "block": 39,
      "item": 5,
      "text": "Apie Austėją kol kas nekalbėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 296.775,
      "end": 299.725,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-039-i-005.mp3"
    },
    {
      "mark": "p-040-i-000",
      "block": 40,
      "item": 0,
      "text": "— O jūs seniai čia gyvenate?",
      "voice": "lt-LT-LeonasNeural",
      "start": 299.725,
      "end": 302.525,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-040-i-000.mp3"
    },
    {
      "mark": "p-040-i-001",
      "block": 40,
      "item": 1,
      "text": "— paklausė Tomas. — Šiame rajone?",
      "voice": "lt-LT-LeonasNeural",
      "start": 302.525,
      "end": 306.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-040-i-001.mp3"
    },
    {
      "mark": "p-041-i-000",
      "block": 41,
      "item": 0,
      "text": "— Trejus metus. Mano butas mažas,",
      "voice": "lt-LT-OnaNeural",
      "start": 306.875,
      "end": 310.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-041-i-000.mp3"
    },
    {
      "mark": "p-041-i-001",
      "block": 41,
      "item": 1,
      "text": "bet virtuvėje telpa normalus stalas.",
      "voice": "lt-LT-OnaNeural",
      "start": 310.1125,
      "end": 313.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-041-i-001.mp3"
    },
    {
      "mark": "p-042-i-000",
      "block": 42,
      "item": 0,
      "text": "— Čia irgi tilps. Kai išnešiu dėžes.",
      "voice": "lt-LT-LeonasNeural",
      "start": 313.4875,
      "end": 318.35,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-042-i-000.mp3"
    },
    {
      "mark": "p-043-i-000",
      "block": 43,
      "item": 0,
      "text": "— Tikrai rytoj? — Ieva nusišypsojo.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Tikrai rytoj? ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— Ieva nusišypsojo.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 318.35,
      "end": 322.975,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-043-i-000.mp3"
    },
    {
      "mark": "p-044-i-000",
      "block": 44,
      "item": 0,
      "text": "— Rytoj šeštadienis. Turiu visą dieną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 322.975,
      "end": 327.6125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-044-i-000.mp3"
    },
    {
      "mark": "p-045-i-000",
      "block": 45,
      "item": 0,
      "text": "— Aš irgi taip sakiau apie savo dėžes.",
      "voice": "lt-LT-OnaNeural",
      "start": 327.6125,
      "end": 330.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-045-i-000.mp3"
    },
    {
      "mark": "p-045-i-001",
      "block": 45,
      "item": 1,
      "text": "Viena dar stovi po stalu.",
      "voice": "lt-LT-OnaNeural",
      "start": 330.925,
      "end": 333.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-045-i-001.mp3"
    },
    {
      "mark": "p-045-i-002",
      "block": 45,
      "item": 2,
      "text": "Katė mano, kad čia jos namas.",
      "voice": "lt-LT-OnaNeural",
      "start": 333.6375,
      "end": 336.5125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-045-i-002.mp3"
    },
    {
      "mark": "p-046-i-000",
      "block": 46,
      "item": 0,
      "text": "— Vadinasi, dėžė jau turi gyventoją.",
      "voice": "lt-LT-LeonasNeural",
      "start": 336.5125,
      "end": 339.8625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-046-i-000.mp3"
    },
    {
      "mark": "p-047-i-000",
      "block": 47,
      "item": 0,
      "text": "— Ir jis nieko nemoka.",
      "voice": "lt-LT-OnaNeural",
      "start": 339.8625,
      "end": 342.425,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-047-i-000.mp3"
    },
    {
      "mark": "p-048-i-000",
      "block": 48,
      "item": 0,
      "text": "Tomas nusijuokė. Jo bute nebuvo katės,",
      "voice": "lt-LT-LeonasNeural",
      "start": 342.425,
      "end": 346.325,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-048-i-000.mp3"
    },
    {
      "mark": "p-048-i-001",
      "block": 48,
      "item": 1,
      "text": "bet viena dėžė jau turėjo paskirtį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 346.325,
      "end": 349.475,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-048-i-001.mp3"
    },
    {
      "mark": "p-048-i-002",
      "block": 48,
      "item": 2,
      "text": "Ant jos jis visą vakarą dėjo telefoną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 349.475,
      "end": 352.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-048-i-002.mp3"
    },
    {
      "mark": "p-048-i-003",
      "block": 48,
      "item": 3,
      "text": "Ir vis tiek jo ieškojo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 352.825,
      "end": 355.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-048-i-003.mp3"
    },
    {
      "mark": "p-049-i-000",
      "block": 49,
      "item": 0,
      "text": "— Ar norėtumėte arbatos? — paklausė jis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 355.4125,
      "end": 360.2125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-049-i-000.mp3"
    },
    {
      "mark": "p-050-i-000",
      "block": 50,
      "item": 0,
      "text": "— Ačiū, bet šiandien jau ne.",
      "voice": "lt-LT-OnaNeural",
      "start": 360.2125,
      "end": 362.9875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-050-i-000.mp3"
    },
    {
      "mark": "p-051-i-000",
      "block": 51,
      "item": 0,
      "text": "Jis pažiūrėjo į laiką ir linktelėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 362.9875,
      "end": 366.0,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-051-i-000.mp3"
    },
    {
      "mark": "p-051-i-001",
      "block": 51,
      "item": 1,
      "text": "Dėžutėse dar buvo keli vištienos gabaliukai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 366.0,
      "end": 369.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-051-i-001.mp3"
    },
    {
      "mark": "p-051-i-002",
      "block": 51,
      "item": 2,
      "text": "Jie ramiai baigė valgyti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 369.5375,
      "end": 372.0625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-051-i-002.mp3"
    },
    {
      "mark": "p-052-i-000",
      "block": 52,
      "item": 0,
      "text": "Kai dėžutės buvo tuščios, Ieva pažiūrėjo į laikrodį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 372.0625,
      "end": 376.3375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-052-i-000.mp3"
    },
    {
      "mark": "p-053-i-000",
      "block": 53,
      "item": 0,
      "text": "— Turiu eiti. Tėčiui reikia kelių dalykų.",
      "voice": "lt-LT-OnaNeural",
      "start": 376.3375,
      "end": 381.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-053-i-000.mp3"
    },
    {
      "mark": "p-053-i-001",
      "block": 53,
      "item": 1,
      "text": "Užsuksiu į parduotuvę, kol dar dirba.",
      "voice": "lt-LT-OnaNeural",
      "start": 381.4125,
      "end": 384.8625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-053-i-001.mp3"
    },
    {
      "mark": "p-054-i-000",
      "block": 54,
      "item": 0,
      "text": "— Gerai. Tik dar vienas dalykas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 384.8625,
      "end": 388.9125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-054-i-000.mp3"
    },
    {
      "mark": "p-054-i-001",
      "block": 54,
      "item": 1,
      "text": "Kitą penktadienį vėl ateis kvietimas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 388.9125,
      "end": 392.2625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-054-i-001.mp3"
    },
    {
      "mark": "p-055-i-000",
      "block": 55,
      "item": 0,
      "text": "Ieva sustojo prie durų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 392.2625,
      "end": 394.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-055-i-000.mp3"
    },
    {
      "mark": "p-056-i-000",
      "block": 56,
      "item": 0,
      "text": "— Gal kitą kartą nuspręskime patys?",
      "voice": "lt-LT-OnaNeural",
      "start": 394.8875,
      "end": 398.3375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-056-i-000.mp3"
    },
    {
      "mark": "p-057-i-000",
      "block": 57,
      "item": 0,
      "text": "Tomas grįžo prie telefono ir atidarė nustatymus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 398.3375,
      "end": 402.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-057-i-000.mp3"
    },
    {
      "mark": "p-058-i-000",
      "block": 58,
      "item": 0,
      "text": "— Išjunk bendrą vakarienę penktadieniais.",
      "voice": "lt-LT-LeonasNeural",
      "start": 402.3125,
      "end": 405.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-058-i-000.mp3"
    },
    {
      "mark": "p-059-i-000",
      "block": 59,
      "item": 0,
      "text": "— Nebesiųsti kvietimų ir nebeužsakyti maisto dviem?",
      "voice": "lt-LT-LeonasNeural",
      "start": 405.6,
      "end": 409.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-059-i-000.mp3"
    },
    {
      "mark": "p-060-i-000",
      "block": 60,
      "item": 0,
      "text": "— Taip. Šitą „taip“ sakau tikrai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 409.4625,
      "end": 414.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-060-i-000.mp3"
    },
    {
      "mark": "p-061-i-000",
      "block": 61,
      "item": 0,
      "text": "Ekrane atsirado žodis „Išjungta“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 414.4875,
      "end": 417.8375,
