      "start": 417.8375,
      "end": 421.0875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-061-i-001.mp3"
    },
    {
      "mark": "p-062-i-000",
      "block": 62,
      "item": 0,
      "text": "— Ačiū už vakarienę, Tomai.",
