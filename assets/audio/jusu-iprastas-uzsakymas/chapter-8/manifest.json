{
  "provider": "Azure Speech",
  "sourceSha256": "c4f0e3349ce7797dc7f9af661a3a1035092ccdc1af15e85984e77d92e8f5b7a5",
  "timingVersion": 2,
  "voiceSwitchGapSeconds": 0.0625,
  "sampleRate": 24000,
  "duration": 501.888,
  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Ketvirtadienį Tomas pietavo kartu su Rasa.",
      "voice": "lt-LT-LeonasNeural",
      "start": 0,
      "end": 3.7125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Ji paklausė apie naują butą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 3.7125,
      "end": 6.525,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "Tomas papasakojo apie dėžes ir keptuvę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 6.525,
      "end": 10.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "— Tai dabar jau gamini?",
      "voice": "lt-LT-OnaNeural",
      "start": 10.1,
      "end": 12.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-001-i-000.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "— Bulves ir makaronus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 12.5375,
      "end": 15.2,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Šiandien bandysiu ką nors kito.",
      "voice": "lt-LT-LeonasNeural",
      "start": 15.2,
      "end": 18.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-002-i-001.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "Rasa padėjo šakutę ir pažiūrėjo į jį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 18.1625,
      "end": 21.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-003-i-000.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "— Galiu atsiųsti vieną receptą. Visai paprastas.",
      "voice": "lt-LT-OnaNeural",
      "start": 21.925,
      "end": 27.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-004-i-000.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "— Kiek laiko reikia?",
      "voice": "lt-LT-LeonasNeural",
      "start": 27.1625,
      "end": 29.3375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-005-i-000.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "— Apie valandą. Gal truputį daugiau.",
      "voice": "lt-LT-OnaNeural",
      "start": 29.3375,
      "end": 33.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-006-i-000.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "Tomas įsivaizdavo save prie viryklės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 33.875,
      "end": 37.1875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-007-i-000.mp3"
    },
    {
      "mark": "p-007-i-001",
      "block": 7,
      "item": 1,
      "text": "Dar reikės perskaityti receptą ir rasti produktus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 37.1875,
      "end": 41.2125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-007-i-001.mp3"
    },
    {
      "mark": "p-007-i-002",
      "block": 7,
      "item": 2,
      "text": "Rasos valanda jam turbūt užtruks ilgiau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 41.2125,
      "end": 44.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-007-i-002.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Atsiųsk. Tik šiandien gaminsime dviese.",
      "voice": "lt-LT-LeonasNeural",
      "start": 44.8875,
      "end": 49.6625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-008-i-000.mp3"
    },
    {
      "mark": "p-008-i-001",
      "block": 8,
      "item": 1,
      "text": "Nenoriu visko nuspręsti iš anksto.",
      "voice": "lt-LT-LeonasNeural",
      "start": 49.6625,
      "end": 52.85,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-008-i-001.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "— Tada pirmiausia paklausk, ką mėgsta viešnia.",
      "voice": "lt-LT-OnaNeural",
      "start": 52.85,
      "end": 56.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-009-i-000.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "— Aš nesakiau, kad ateis viešnia.",
      "voice": "lt-LT-LeonasNeural",
      "start": 56.4625,
      "end": 59.2375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-010-i-000.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— Ir dabar nepasakei, kad neateis.",
      "voice": "lt-LT-OnaNeural",
      "start": 59.2375,
      "end": 62.4375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-011-i-000.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "Tomas nusijuokė, bet daugiau nepasakojo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 62.4375,
      "end": 65.8125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-012-i-000.mp3"
    },
    {
      "mark": "p-012-i-001",
      "block": 12,
      "item": 1,
      "text": "Tuo metu suskambo Rasos telefonas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 65.8125,
      "end": 69.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-012-i-001.mp3"
    },
    {
      "mark": "p-012-i-002",
      "block": 12,
      "item": 2,
      "text": "Ji pažiūrėjo į ekraną ir atsistojo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 69.0125,
      "end": 72.3,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-012-i-002.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Turiu grįžti. Čia dėl rytojaus užsakymų.",
      "voice": "lt-LT-OnaNeural",
      "start": 72.3,
      "end": 77.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "Rasa nusinešė pietus prie savo stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 77.3125,
      "end": 80.7125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "Tomas liko prie lango ir baigė valgyti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 80.7125,
      "end": 84.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-014-i-001.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "Po pietų darbo buvo daug.",
      "voice": "lt-LT-LeonasNeural",
      "start": 84.1125,
      "end": 86.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "Tomas atsakė į klientų žinutes.",
      "voice": "lt-LT-LeonasNeural",
      "start": 86.7875,
      "end": 89.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-015-i-001.mp3"
    },
    {
      "mark": "p-015-i-002",
      "block": 15,
      "item": 2,
      "text": "Tada reikėjo baigti užsakymų sąrašą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 89.825,
      "end": 93.075,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-015-i-002.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "Vieno kliento žinutėse rado dvi skirtingas dienas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 93.075,
      "end": 97.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "Vienur buvo penktadienis, kitur — šeštadienis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 97.1,
      "end": 100.9,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-016-i-001.mp3"
    },
    {
      "mark": "p-016-i-002",
      "block": 16,
      "item": 2,
      "text": "Tomas peržiūrėjo abi žinutes dar kartą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 100.9,
      "end": 104.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-016-i-002.mp3"
    },
    {
      "mark": "p-016-i-003",
      "block": 16,
      "item": 3,
      "text": "Paskui paskambino numeriu iš sąrašo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 104.375,
      "end": 107.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-016-i-003.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "Niekas neatsiliepė. Telefone rado vakarykštę žinutę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 107.6375,
      "end": 113.175,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-017-i-000.mp3"
    },
    {
      "mark": "p-017-i-001",
      "block": 17,
      "item": 1,
      "text": "Toje žinutėje buvo jo naujas numeris.",
      "voice": "lt-LT-LeonasNeural",
      "start": 113.175,
      "end": 116.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-017-i-001.mp3"
    },
    {
      "mark": "p-017-i-002",
      "block": 17,
      "item": 2,
      "text": "Šį kartą vyras atsiliepė iš karto.",
      "voice": "lt-LT-LeonasNeural",
      "start": 116.4875,
      "end": 119.775,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-017-i-002.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Laba diena. Ar galite trumpai pasikalbėti?",
      "voice": "lt-LT-LeonasNeural",
      "start": 119.775,
      "end": 124.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-018-i-000.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "— Galiu. Tik po penkių minučių išeinu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 124.6,
      "end": 129.15,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-019-i-000.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "— Kada pristatyti užsakymą? Penktadienį ar šeštadienį?",
      "voice": "lt-LT-LeonasNeural",
      "start": 129.15,
      "end": 134.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Penktadienį, iki pietų. Šeštadienį išvažiuoju.",
      "voice": "lt-LT-LeonasNeural",
      "start": 134.4625,
      "end": 139.6125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-021-i-000.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "— Gerai. Adresas tas pats?",
      "voice": "lt-LT-LeonasNeural",
      "start": 139.6125,
      "end": 143.6875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-022-i-000.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "— Ne, šį kartą reikia į biurą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 143.6875,
      "end": 146.625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-023-i-000.mp3"
    },
    {
      "mark": "p-023-i-001",
      "block": 23,
      "item": 1,
      "text": "Adresą atsiųsiu, kai grįšiu prie kompiuterio.",
      "voice": "lt-LT-LeonasNeural",
      "start": 146.625,
      "end": 150.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-023-i-001.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "Tomas paprašė atsiųsti adresą iki pusės šeštos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 150.1125,
      "end": 154.15,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-024-i-000.mp3"
    },
    {
      "mark": "p-024-i-001",
      "block": 24,
      "item": 1,
      "text": "Vyras pažadėjo. Pokalbis užtruko dvi minutes.",
      "voice": "lt-LT-LeonasNeural",
      "start": 154.15,
      "end": 159.275,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-024-i-001.mp3"
    },
    {
      "mark": "p-024-i-002",
      "block": 24,
      "item": 2,
      "text": "Tomas pakeitė dieną ir įrašė naują numerį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 159.275,
      "end": 163.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-024-i-002.mp3"
    },
    {
      "mark": "p-024-i-003",
      "block": 24,
      "item": 3,
      "text": "Vietą adresui kol kas paliko tuščią.",
      "voice": "lt-LT-LeonasNeural",
      "start": 163.1125,
      "end": 166.3875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-024-i-003.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Pusę šeštos žinutės dar nebuvo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 166.3875,
      "end": 169.3625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Tomas parašė trumpą priminimą ir grįžo prie darbo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 169.3625,
      "end": 173.4,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-025-i-001.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "„Dar laukiu adreso. Sąrašą išsiųsiu prieš šeštą.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 173.4,
      "end": 178.7375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-026-i-000.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "Tada telefoną padėjo šalia klaviatūros.",
      "voice": "lt-LT-LeonasNeural",
      "start": 178.7375,
      "end": 182.2375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "Dar reikėjo patikrinti kainas kituose užsakymuose.",
      "voice": "lt-LT-LeonasNeural",
      "start": 182.2375,
      "end": 186.175,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-027-i-001.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "Be dvidešimties šeštą prie jo priėjo Rasa.",
      "voice": "lt-LT-LeonasNeural",
      "start": 186.175,
      "end": 189.7125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Rankoje laikė dar du lapus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 189.7125,
      "end": 192.625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-028-i-001.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "— Gal gali patikrinti ir šituos užsakymus?",
      "voice": "lt-LT-OnaNeural",
      "start": 192.625,
      "end": 196.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Klientas laukia atsakymo rytoj iki dešimtos.",
      "voice": "lt-LT-OnaNeural",
      "start": 196.5375,
      "end": 200.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-029-i-001.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "Tomas paėmė lapus ir peržiūrėjo pirmą puslapį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 200.6,
      "end": 204.4375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-030-i-000.mp3"
    },
    {
      "mark": "p-030-i-001",
      "block": 30,
      "item": 1,
      "text": "Darbui reikės mažiausiai pusės valandos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 204.4375,
      "end": 207.9125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-030-i-001.mp3"
    },
    {
      "mark": "p-030-i-002",
      "block": 30,
      "item": 2,
      "text": "O savo sąrašo jis dar nebaigė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 207.9125,
      "end": 210.9,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-030-i-002.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "— Čia visi nauji užsakymai?",
      "voice": "lt-LT-LeonasNeural",
      "start": 210.9,
      "end": 213.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-031-i-000.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "— Ne. Keli seni, tik pakeitė kiekius.",
      "voice": "lt-LT-OnaNeural",
      "start": 213.6,
      "end": 218.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-032-i-000.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "Tomas norėjo tuoj pat pradėti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 218.825,
      "end": 221.8625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-033-i-000.mp3"
    },
    {
      "mark": "p-033-i-001",
      "block": 33,
      "item": 1,
      "text": "Rasa jam irgi ne kartą padėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 221.8625,
      "end": 224.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-033-i-001.mp3"
    },
    {
      "mark": "p-033-i-002",
      "block": 33,
      "item": 2,
      "text": "Jis padėjo Rasos lapus prie kompiuterio.",
      "voice": "lt-LT-LeonasNeural",
      "start": 224.875,
      "end": 228.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-033-i-002.mp3"
    },
    {
      "mark": "p-033-i-003",
      "block": 33,
      "item": 3,
      "text": "Jo paties sąraše vis dar trūko adreso.",
      "voice": "lt-LT-LeonasNeural",
      "start": 228.225,
      "end": 231.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-033-i-003.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "— Rytoj galiu pradėti devintą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 231.8,
      "end": 234.6875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-034-i-000.mp3"
    },
    {
      "mark": "p-034-i-001",
      "block": 34,
      "item": 1,
      "text": "Iki pusės dešimtos patikrinsiu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 234.6875,
      "end": 237.7625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-034-i-001.mp3"
    },
    {
      "mark": "p-035-i-000",
      "block": 35,
      "item": 0,
      "text": "— Šiandien būtų ramiau, — pasakė Rasa.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Šiandien būtų ramiau, ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— pasakė Rasa.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 237.7625,
      "end": 242.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-035-i-000.mp3"
    },
    {
      "mark": "p-036-i-000",
      "block": 36,
      "item": 0,
      "text": "Ji irgi pažiūrėjo į laikrodį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 242.1375,
      "end": 245.025,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-036-i-000.mp3"
    },
    {
      "mark": "p-036-i-001",
      "block": 36,
      "item": 1,
      "text": "Ant jos stalo buvo šalti pietūs.",
      "voice": "lt-LT-LeonasNeural",
      "start": 245.025,
      "end": 248.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-036-i-001.mp3"
    },
    {
      "mark": "p-036-i-002",
      "block": 36,
      "item": 2,
      "text": "Pietų ji taip ir nebaigė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 248.1375,
      "end": 250.725,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-036-i-002.mp3"
    },
    {
      "mark": "p-037-i-000",
      "block": 37,
      "item": 0,
      "text": "— Suprantu. Bet šiandien turiu išeiti šeštą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 250.725,
      "end": 255.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-037-i-000.mp3"
    },
    {
      "mark": "p-037-i-001",
      "block": 37,
      "item": 1,
      "text": "Septintą laukiu viešnios. Dar reikia į parduotuvę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 255.6,
      "end": 260.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-037-i-001.mp3"
    },
    {
      "mark": "p-038-i-000",
      "block": 38,
      "item": 0,
      "text": "— O jeigu rytoj kas nors paskambins?",
      "voice": "lt-LT-OnaNeural",
      "start": 260.875,
      "end": 264.425,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-038-i-000.mp3"
    },
    {
      "mark": "p-039-i-000",
      "block": 39,
      "item": 0,
      "text": "— Tada paprašysiu perskambinti po pusės dešimtos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 264.425,
      "end": 268.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-039-i-000.mp3"
    },
    {
      "mark": "p-039-i-001",
      "block": 39,
      "item": 1,
      "text": "Tuos užsakymus tikrinsiu pirmiausia.",
      "voice": "lt-LT-LeonasNeural",
      "start": 268.3125,
      "end": 271.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-039-i-001.mp3"
    },
    {
      "mark": "p-040-i-000",
      "block": 40,
      "item": 0,
      "text": "— Aš nuo devintos būsiu susitikime.",
      "voice": "lt-LT-OnaNeural",
      "start": 271.4625,
      "end": 274.55,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-040-i-000.mp3"
    },
    {
      "mark": "p-040-i-001",
      "block": 40,
      "item": 1,
      "text": "Ten negalėsiu visą laiką žiūrėti į telefoną.",
      "voice": "lt-LT-OnaNeural",
      "start": 274.55,
      "end": 278.35,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-040-i-001.mp3"
    },
    {
      "mark": "p-041-i-000",
      "block": 41,
      "item": 0,
      "text": "— Suprantu. Klausimus atsiųsiu viena žinute.",
      "voice": "lt-LT-LeonasNeural",
      "start": 278.35,
      "end": 283.2875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-041-i-000.mp3"
    },
    {
      "mark": "p-041-i-001",
      "block": 41,
      "item": 1,
      "text": "Atsakysi, kai galėsi.",
      "voice": "lt-LT-LeonasNeural",
      "start": 283.2875,
      "end": 285.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-041-i-001.mp3"
    },
    {
      "mark": "p-042-i-000",
      "block": 42,
      "item": 0,
      "text": "— Tada atsiųsiu ir seną sąrašą.",
      "voice": "lt-LT-OnaNeural",
      "start": 285.8875,
      "end": 288.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-042-i-000.mp3"
    },
    {
      "mark": "p-042-i-001",
      "block": 42,
      "item": 1,
      "text": "Bus lengviau patikrinti, kas pasikeitė.",
      "voice": "lt-LT-OnaNeural",
      "start": 288.925,
      "end": 292.425,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-042-i-001.mp3"
    },
    {
      "mark": "p-043-i-000",
      "block": 43,
      "item": 0,
      "text": "Rasa peržiūrėjo savo kalendorių telefone.",
      "voice": "lt-LT-LeonasNeural",
      "start": 292.425,
      "end": 296.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-043-i-000.mp3"
    },
    {
      "mark": "p-044-i-000",
      "block": 44,
      "item": 0,
      "text": "— Susitikimas baigsis devintą dvidešimt.",
      "voice": "lt-LT-OnaNeural",
      "start": 296.1,
      "end": 299.525,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-044-i-000.mp3"
    },
    {
      "mark": "p-044-i-001",
      "block": 44,
      "item": 1,
      "text": "Paskui turėsiu laiko atsakyti į tavo klausimus.",
      "voice": "lt-LT-OnaNeural",
      "start": 299.525,
      "end": 303.5125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-044-i-001.mp3"
    },
    {
      "mark": "p-045-i-000",
      "block": 45,
      "item": 0,
      "text": "— Gerai. Rytoj pradėsiu nuo šito sąrašo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 303.5125,
      "end": 308.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-045-i-000.mp3"
    },
    {
      "mark": "p-046-i-000",
      "block": 46,
      "item": 0,
      "text": "Tomas grąžino jai lapus,",
      "voice": "lt-LT-LeonasNeural",
      "start": 308.3125,
      "end": 309.975,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-046-i-000.mp3"
    },
    {
      "mark": "p-046-i-001",
      "block": 46,
      "item": 1,
      "text": "bet pastebėjo vieną pažįstamą vardą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 309.975,
      "end": 313.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-046-i-001.mp3"
    },
    {
      "mark": "p-047-i-000",
      "block": 47,
      "item": 0,
      "text": "— Su šituo klientu kalbėjau ir šiandien.",
      "voice": "lt-LT-LeonasNeural",
      "start": 313.0125,
      "end": 316.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-047-i-000.mp3"
    },
    {
      "mark": "p-047-i-001",
      "block": 47,
      "item": 1,
      "text": "Jis dabar turi kitą telefono numerį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 316.1,
      "end": 319.475,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-047-i-001.mp3"
    },
    {
      "mark": "p-048-i-000",
      "block": 48,
      "item": 0,
      "text": "— Todėl ir neatsiliepia! Gali atsiųsti?",
      "voice": "lt-LT-OnaNeural",
      "start": 319.475,
      "end": 324.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-048-i-000.mp3"
    },
    {
      "mark": "p-049-i-000",
      "block": 49,
      "item": 0,
      "text": "Tomas surado vakarykštę žinutę ir persiuntė Rasai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 324.225,
      "end": 328.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-049-i-000.mp3"
    },
    {
      "mark": "p-049-i-001",
      "block": 49,
      "item": 1,
      "text": "Tai užtruko tris minutes.",
      "voice": "lt-LT-LeonasNeural",
      "start": 328.1625,
      "end": 330.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-049-i-001.mp3"
    },
    {
      "mark": "p-050-i-000",
      "block": 50,
      "item": 0,
      "text": "— Ačiū. Dabar bent galėsiu jam paskambinti.",
      "voice": "lt-LT-OnaNeural",
      "start": 330.8875,
      "end": 336.2,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-050-i-000.mp3"
    },
    {
      "mark": "p-051-i-000",
      "block": 51,
      "item": 0,
      "text": "Tomas grįžo prie savo sąrašo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 336.2,
      "end": 339.175,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-051-i-000.mp3"
    },
    {
      "mark": "p-052-i-000",
      "block": 52,
      "item": 0,
      "text": "Be dešimties šeštą klientas pagaliau atsiuntė adresą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 339.175,
      "end": 343.4,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-052-i-000.mp3"
    },
    {
      "mark": "p-052-i-001",
      "block": 52,
      "item": 1,
      "text": "Pridėjo, kad durys yra iš kiemo pusės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 343.4,
      "end": 346.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-052-i-001.mp3"
    },
    {
      "mark": "p-052-i-002",
      "block": 52,
      "item": 2,
      "text": "Prie gatvės nėra nei numerio, nei skambučio.",
      "voice": "lt-LT-LeonasNeural",
      "start": 346.6,
      "end": 350.15,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-052-i-002.mp3"
    },
    {
      "mark": "p-053-i-000",
      "block": 53,
      "item": 0,
      "text": "Tomas įrašė ir šitą sakinį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 350.15,
      "end": 353.175,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-053-i-000.mp3"
    },
    {
      "mark": "p-053-i-001",
      "block": 53,
      "item": 1,
      "text": "Vien adreso rytoj gali neužtekti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 353.175,
      "end": 356.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-053-i-001.mp3"
    },
    {
      "mark": "p-053-i-002",
      "block": 53,
      "item": 2,
      "text": "Kurjeriui bent nereikės ieškoti durų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 356.4875,
      "end": 359.7625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-053-i-002.mp3"
    },
    {
      "mark": "p-054-i-000",
      "block": 54,
      "item": 0,
      "text": "Paskutiniuose dviejuose užsakymuose klaidų nebuvo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 359.7625,
      "end": 363.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-054-i-000.mp3"
    },
    {
      "mark": "p-054-i-001",
      "block": 54,
      "item": 1,
      "text": "Be dviejų šeštą išsiuntė sąrašą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 363.5375,
      "end": 366.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-054-i-001.mp3"
    },
    {
      "mark": "p-055-i-000",
      "block": 55,
      "item": 0,
      "text": "Rasa kalbėjo telefonu prie lango.",
      "voice": "lt-LT-LeonasNeural",
      "start": 366.45,
      "end": 369.475,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-055-i-000.mp3"
    },
    {
      "mark": "p-055-i-001",
      "block": 55,
      "item": 1,
      "text": "Pamačiusi jo striukę, pakėlė ranką.",
      "voice": "lt-LT-LeonasNeural",
      "start": 369.475,
      "end": 372.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-055-i-001.mp3"
    },
    {
      "mark": "p-056-i-000",
      "block": 56,
      "item": 0,
      "text": "— Iki rytojaus, — tyliai pasakė Tomas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 372.8,
      "end": 376.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-056-i-000.mp3"
    },
    {
      "mark": "p-057-i-000",
      "block": 57,
      "item": 0,
      "text": "Iki stotelės jis ėjo dešimt minučių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 376.0125,
      "end": 379.3875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-057-i-000.mp3"
    },
    {
      "mark": "p-057-i-001",
      "block": 57,
      "item": 1,
      "text": "Autobusas atvažiavo šeštą dvylika.",
      "voice": "lt-LT-LeonasNeural",
      "start": 379.3875,
      "end": 382.85,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-057-i-001.mp3"
    },
    {
      "mark": "p-057-i-002",
      "block": 57,
      "item": 2,
      "text": "Šį kartą Tomas spėjo be bėgimo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 382.85,
      "end": 385.975,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-057-i-002.mp3"
    },
    {
      "mark": "p-058-i-000",
      "block": 58,
      "item": 0,
      "text": "Autobuse atėjo Rasos žinutė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 385.975,
      "end": 389.0,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-058-i-000.mp3"
    },
    {
      "mark": "p-059-i-000",
      "block": 59,
      "item": 0,
      "text": "„Sąrašą ir receptą išsiunčiau.",
      "voice": "lt-LT-OnaNeural",
      "start": 389.0,
      "end": 392.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-059-i-000.mp3"
    },
    {
      "mark": "p-059-i-001",
      "block": 59,
      "item": 1,
      "text": "Numeris veikia. Gero vakaro!“",
      "voice": "lt-LT-OnaNeural",
      "start": 392.1,
      "end": 396.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-059-i-001.mp3"
    },
    {
      "mark": "p-060-i-000",
      "block": 60,
      "item": 0,
      "text": "Tomas padėkojo ir uždarė žinutę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 396.4625,
      "end": 399.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-060-i-000.mp3"
    },
    {
      "mark": "p-060-i-001",
      "block": 60,
      "item": 1,
      "text": "Sąrašą atidarys rytoj devintą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 399.8,
      "end": 402.95,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-060-i-001.mp3"
    },
    {
      "mark": "p-061-i-000",
      "block": 61,
      "item": 0,
      "text": "Jis atsidarė rytojaus kalendorių telefone.",
      "voice": "lt-LT-LeonasNeural",
      "start": 402.95,
      "end": 406.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-061-i-000.mp3"
    },
    {
      "mark": "p-061-i-001",
      "block": 61,
      "item": 1,
      "text": "Nuo devintos iki pusės dešimtos pažymėjo darbą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 406.6375,
      "end": 410.5875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-061-i-001.mp3"
    },
    {
      "mark": "p-061-i-002",
      "block": 61,
      "item": 2,
      "text": "Priminimą pavadino „Rasos sąrašas“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 410.5875,
      "end": 413.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-061-i-002.mp3"
    },
    {
      "mark": "p-061-i-003",
      "block": 61,
      "item": 3,
      "text": "Pridėjo: „Palyginti kiekius. Klausimus atsiųsti viena žinute.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 413.7875,
      "end": 419.6625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-061-i-003.mp3"
    },
    {
      "mark": "p-062-i-000",
      "block": 62,
      "item": 0,
      "text": "Tada telefoną įsidėjo į kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 419.6625,
      "end": 422.9375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-062-i-000.mp3"
    },
    {
      "mark": "p-062-i-001",
      "block": 62,
      "item": 1,
      "text": "Pro langą jau matė pažįstamą parduotuvę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 422.9375,
      "end": 426.4,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-062-i-001.mp3"
    },
    {
      "mark": "p-063-i-000",
      "block": 63,
      "item": 0,
      "text": "Parduotuvėje duonos lentyna buvo beveik tuščia.",
      "voice": "lt-LT-LeonasNeural",
      "start": 426.4,
      "end": 430.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-063-i-000.mp3"
    },
    {
      "mark": "p-064-i-000",
      "block": 64,
      "item": 0,
      "text": "— Ar dar turite tokios duonos?",
      "voice": "lt-LT-LeonasNeural",
      "start": 430.225,
      "end": 433.1875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-064-i-000.mp3"
    },
    {
      "mark": "p-065-i-000",
      "block": 65,
      "item": 0,
      "text": "Jis parodė į vietą šalia kainos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 433.1875,
      "end": 436.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-065-i-000.mp3"
    },
    {
      "mark": "p-066-i-000",
      "block": 66,
      "item": 0,
      "text": "— Tik didelį kepalą. Mažų bus vėliau.",
      "voice": "lt-LT-OnaNeural",
      "start": 436.1125,
      "end": 440.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-066-i-000.mp3"
    },
    {
      "mark": "p-067-i-000",
      "block": 67,
      "item": 0,
      "text": "— Po kiek laiko?",
      "voice": "lt-LT-LeonasNeural",
      "start": 440.8,
      "end": 442.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-067-i-000.mp3"
    },
    {
      "mark": "p-068-i-000",
      "block": 68,
      "item": 0,
      "text": "— Maždaug po dvidešimties minučių.",
      "voice": "lt-LT-OnaNeural",
      "start": 442.8,
      "end": 445.8125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-068-i-000.mp3"
    },
    {
      "mark": "p-069-i-000",
      "block": 69,
      "item": 0,
      "text": "Buvo šešios trisdešimt aštuonios.",
      "voice": "lt-LT-LeonasNeural",
      "start": 445.8125,
      "end": 448.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-069-i-000.mp3"
    },
    {
      "mark": "p-069-i-001",
      "block": 69,
      "item": 1,
      "text": "Tomas pažiūrėjo į didelį kepalą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 448.8875,
      "end": 451.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-069-i-001.mp3"
    },
    {
      "mark": "p-069-i-002",
      "block": 69,
      "item": 2,
      "text": "Viso nereikėjo, o laukti jau buvo vėlu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 451.825,
      "end": 455.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-069-i-002.mp3"
    },
    {
      "mark": "p-070-i-000",
      "block": 70,
      "item": 0,
      "text": "— Galiu perpjauti dabar, — pasiūlė pardavėja.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— Galiu perpjauti dabar, ",
          "voice": "lt-LT-OnaNeural"
        },
        {
          "text": "— pasiūlė pardavėja.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 455.4125,
      "end": 460.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-070-i-000.mp3"
    },
    {
      "mark": "p-070-i-001",
      "block": 70,
      "item": 1,
      "text": "— Pusės užteks?",
      "voice": "lt-LT-OnaNeural",
      "start": 460.375,
      "end": 462.675,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-070-i-001.mp3"
    },
    {
      "mark": "p-071-i-000",
      "block": 71,
      "item": 0,
      "text": "— Užteks. Pusę, prašau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 462.675,
      "end": 466.85,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-071-i-000.mp3"
    },
    {
      "mark": "p-072-i-000",
      "block": 72,
      "item": 0,
      "text": "Pardavėja perpjovė kepalą ir padavė jam pusę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 466.85,
      "end": 470.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-072-i-000.mp3"
    },
    {
      "mark": "p-072-i-001",
      "block": 72,
      "item": 1,
      "text": "Tomas sumokėjo ir įsidėjo duoną į krepšį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 470.7875,
      "end": 474.3625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-072-i-001.mp3"
    },
    {
      "mark": "p-073-i-000",
      "block": 73,
      "item": 0,
      "text": "Namo grįžo be dešimties septintą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 474.3625,
      "end": 477.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-000.mp3"
    },
    {
      "mark": "p-073-i-001",
      "block": 73,
      "item": 1,
      "text": "Duoną padėjo ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 477.4625,
      "end": 480.1,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-001.mp3"
    },
    {
      "mark": "p-073-i-002",
      "block": 73,
      "item": 2,
      "text": "Nuo antros kėdės paėmė striukę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 480.1,
      "end": 483.1125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-002.mp3"
    },
    {
      "mark": "p-073-i-003",
      "block": 73,
      "item": 3,
      "text": "Pakabino ją prie durų ir nuvalė stalą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 483.1125,
      "end": 486.5125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-003.mp3"
    },
    {
      "mark": "p-073-i-004",
      "block": 73,
      "item": 4,
      "text": "Šiandien abiem bus kur atsisėsti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 486.5125,
      "end": 489.725,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-004.mp3"
    },
    {
      "mark": "p-073-i-005",
      "block": 73,
      "item": 5,
      "text": "Krepšyje dar liko baltas lapelis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 489.725,
      "end": 492.95,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-073-i-005.mp3"
    },
    {
      "mark": "p-074-i-000",
      "block": 74,
      "item": 0,
      "text": "„Darbas namuose?“ — pagalvojo Tomas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 492.95,
      "end": 496.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-074-i-000.mp3"
    },
    {
      "mark": "p-074-i-001",
      "block": 74,
      "item": 1,
      "text": "Ištraukė lapelį ir nusijuokė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 496.375,
      "end": 499.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-074-i-001.mp3"
    },
    {
      "mark": "p-074-i-002",
      "block": 74,
      "item": 2,
      "text": "Tai buvo duonos čekis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 499.4125,
      "end": 501.888,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-8/p-074-i-002.mp3"
    }
  ],
